{
  "name": "cloud-version-control-learning-project",
  "version": "0.1.0",
  "private": true,
  "description": "A full-stack learning project for cloud development and version control.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,green \"npm run dev --workspace=@cloud-learning/api\" \"npm run dev --workspace=@cloud-learning/web\"",
    "migrate": "npm run migrate --workspace=@cloud-learning/api",
    "prod": "docker compose --env-file .env.production --file compose.production.yaml up --build",
    "lint": "eslint apps",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "start": "npm run start --workspace=@cloud-learning/api"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.73.0"
  }
}
